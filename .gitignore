# 运行产物：每次运行一个目录，体积大且含 PRD 内容，不入库
data/runs/
reports/*.json

# 测试临时目录
tests/_work/
.pytest_tmp/
.pytest_cache/
# 受限环境下 mkdtemp 生成的 0o700 目录，权限受限删不掉，直接忽略
pytest-cache-files-*/
tmp*/

# 环境与密钥
.env
*.key

# Python
__pycache__/
*.pyc
.venv/
.deps/
*.egg-info/

# 编辑器
.vscode/
.idea/

# 本地排查用的临时产物
.chrome-err.txt
.dom.html
.chrome-prof/
.uitest/
