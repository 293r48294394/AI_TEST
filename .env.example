# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不要提交真实 key。

# ---- LLM ----
# mock = 离线启发式基线（无网络、可进 CI）；deepseek = 真实调用
ATP_LLM_MODE=mock
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---- 流水线 ----
ATP_REQUIRE_HUMAN=1          # 1 = 在测试地图阶段暂停等人确认
ATP_MAX_REPAIR=2             # JSON 契约校验失败后的重试轮数
ATP_MAX_CASES_PER_CALL=8     # 用例生成分批大小
ATP_TOP_K=6                  # 检索返回块数
ATP_TEMPERATURE=0.2
ATP_TIMEOUT_S=120

# ---- 目录（可选）----
# ATP_DATA_DIR=./data
# ATP_RUNS_DIR=./data/runs
